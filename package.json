    "test:file-size-policy": "node --test src/utils/__tests__/chatFileSizePolicy.test.mjs",
    "test:encoding": "node --test ./scripts/__tests__/encoding-tools.test.mjs",
    "test:location-ui": "node ./scripts/location-ui-smoke.mjs",
    "test:legal-consent": "node ./scripts/legal-consent-smoke.mjs",
    "test:auth-network-idle": "node --test ./scripts/__tests__/auth-network-idle-policy.test.mjs",
    "test:admin-security-ui": "node --test ./scripts/__tests__/admin-security-ui-policy.test.mjs",
    "test:conversation-spam-report": "node --test ./scripts/__tests__/conversation-spam-report-policy.test.mjs",
    "test:security-config-policy": "node --test ./scripts/__tests__/security-config-policy.test.mjs",
    "test:renderer-csp-policy": "node --test ./scripts/__tests__/renderer-csp-policy.test.mjs",
    "test:electron-permission-policy": "node --test ./scripts/__tests__/electron-permission-policy.test.mjs",
    "test:electron-ipc-policy": "node --test ./scripts/__tests__/electron-ipc-policy.test.mjs",
    "test:deploy-ssh-trust-policy": "node --test ./scripts/__tests__/deploy-ssh-trust-policy.test.mjs",
    "test:chat-payload-protection-policy": "node --test ./scripts/__tests__/chat-payload-protection-policy.test.mjs",
    "test:voice-hub-contract-policy": "node --test ./scripts/__tests__/voice-hub-contract-policy.test.mjs",
    "test:voice-privacy-policy": "node --test ./scripts/__tests__/voice-privacy-policy.test.mjs",
    "test:release-smoke-policy": "node --test ./scripts/__tests__/release-smoke-gate-policy.test.mjs",
    "test:animated-media-policy": "node --test ./scripts/__tests__/animated-media-policy.test.mjs",
    "test:voice-participant-volume-menu": "node --test ./scripts/__tests__/voice-participant-volume-menu-policy.test.mjs",
    "test:media-missing": "node ./scripts/media-missing-smoke.mjs",
    "test:media-preview": "node ./scripts/media-preview-smoke.mjs",
    "test:realtime": "node ./scripts/realtime-smoke.mjs",
    "test:settings-scroll": "node ./scripts/settings-scroll-smoke.mjs",
    "test:upload-ui": "node ./scripts/upload-ui-smoke.mjs",
    "test:voice-device-switch": "node ./scripts/voice-device-switch-smoke.mjs",
    "test:visual:auth": "node ./scripts/visual-smoke-auth.mjs",
    "test:visual:chat": "node ./scripts/visual-smoke-chat.mjs",
    "test:visual:settings": "node ./scripts/visual-smoke-settings.mjs",
    "test:visual:modals": "node ./scripts/visual-smoke-modals.mjs",
    "smoke:auth": "node ./scripts/smoke/auth-smoke.mjs",
    "smoke:chat": "node ./scripts/smoke/chat-smoke.mjs",
    "smoke:upload": "node ./scripts/smoke/upload-smoke.mjs",
    "smoke:voice": "node ./scripts/smoke/voice-smoke.mjs",
    "smoke:release": "npm run smoke:auth && npm run smoke:chat && npm run smoke:upload && npm run smoke:voice",
    "smoke:release:strict": "node ./scripts/smoke/release-strict.mjs",
    "check:db-backup-drill": "powershell -ExecutionPolicy Bypass -File .\\scripts\\db-backup-drill.ps1 -RequireConfigured",
    "load:auth-tokens": "node ./scripts/load/auth-tokens.mjs",
    "load:http": "node ./scripts/load/http-smoke.mjs",
    "load:seed-users": "dotnet run --project scripts/load/SeedLoadUsers/SeedLoadUsers.csproj --configuration Release",
    "load:voice": "node ./scripts/load/voice-signalr.mjs",
    "audit:public-assets": "node ./scripts/audit-public-assets.mjs",
    "audit:perf": "node ./scripts/perf-audit.mjs"
  },
  "keywords": [],
  "author": {
    "name": "Andrey",
    "email": "andrey1689123@gmail.com"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
