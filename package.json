{
  "name": "tend",
  "productName": "Tend",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev:frontend": "vite --config vite.renderer.config.mjs",
    "start:backend": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-backend.ps1",
    "start:livekit": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-livekit.ps1",
    "start:livekit:docker": "docker compose --env-file .env -f src/livekit/docker-compose.yml up -d --force-recreate",
    "build": "npm run build:frontend",
    "build:frontend": "vite build --config vite.renderer.config.mjs",
    "build:hosting": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-hosting-bundle.ps1",
    "package": "electron-forge package",
    "package:prod": "node ./scripts/run-with-runtime.mjs package",
    "make": "electron-forge make",
    "make:prod": "node ./scripts/run-with-runtime.mjs make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --quiet",
    "check:encoding": "node ./scripts/check-encoding.mjs",
    "check:encoding:fix": "node ./scripts/check-encoding.mjs --fix",
    "check:release": "npm run check:encoding && npm run test:encoding && npm run lint:ci && npm run build:frontend && npm run audit:public-assets && npm run audit:perf",
    "test:auth-storage": "node --test src/utils/__tests__/authStoragePolicy.test.mjs",
    "test:attachment-descriptors": "node --test src/utils/__tests__/textChatAttachmentDescriptorPolicy.test.mjs",
    "test:electron-downloads": "node --test src/utils/__tests__/electronDownloadStreamingPolicy.test.mjs",
    "test:file-size-policy": "node --test src/utils/__tests__/chatFileSizePolicy.test.mjs",
    "test:encoding": "node --test ./scripts/__tests__/encoding-tools.test.mjs",
    "test:media-missing": "node ./scripts/media-missing-smoke.mjs",
    "test:media-preview": "node ./scripts/media-preview-smoke.mjs",
    "test:realtime": "node ./scripts/realtime-smoke.mjs",
    "test:visual:chat": "node ./scripts/visual-smoke-chat.mjs",
    "load:auth-tokens": "node ./scripts/load/auth-tokens.mjs",
    "load:http": "node ./scripts/load/http-smoke.mjs",
    "load:seed-users": "dotnet run --project scripts/load/SeedLoadUsers/SeedLoadUsers.csproj --configuration Release",
    "load:voice": "node ./scripts/load/voice-signalr.mjs",
    "audit:public-assets": "node ./scripts/audit-public-assets.mjs",
    "audit:perf": "node ./scripts/perf-audit.mjs"
  },
  "keywords": [],
  "author": {
    "name": "Andrey",
    "email": "andrey1689123@gmail.com"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "private": true,
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.8.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.6",
    "@microsoft/signalr-protocol-msgpack": "^10.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.18.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2"
  }
}
