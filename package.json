    "package": "electron-forge package",
    "package:prod": "node ./scripts/run-with-runtime.mjs package",
    "make": "electron-forge make",
    "make:prod": "node ./scripts/run-with-runtime.mjs make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --quiet",
    "check:encoding": "node ./scripts/check-encoding.mjs",
    "check:encoding:fix": "node ./scripts/check-encoding.mjs --fix",
    "check:release": "npm run check:encoding && npm run test:encoding && npm run test:auth-branding && npm run test:legal-consent && npm run test:release-smoke-policy && npm run test:security-config-policy && npm run test:renderer-csp-policy && npm run test:electron-permission-policy && npm run test:electron-ipc-policy && npm run test:deploy-ssh-trust-policy && npm run test:chat-payload-protection-policy && npm run test:voice-hub-contract-policy && npm run test:voice-privacy-policy && npm run test:animated-media-policy && npm run test:voice-participant-volume-menu && npm run test:auth-network-idle && npm run test:admin-security-ui && npm run test:conversation-spam-report && npm run lint:ci && npm run build:frontend && npm run audit:public-assets && npm run audit:perf && dotnet test BackNoDiscord/BackNoDiscord.Tests/BackNoDiscord.Tests.csproj --configuration Release",
    "test:auth-storage": "node --test src/utils/__tests__/authStoragePolicy.test.mjs",
    "test:auth-branding": "node ./scripts/auth-branding-smoke.mjs",
    "test:auth-registration-code": "node ./scripts/auth-registration-code-smoke.mjs",
    "test:theme": "node ./scripts/auth-theme-smoke.mjs",
