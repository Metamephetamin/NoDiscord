[Unit]
Description=NoDiscord Backend instance on port %i
After=network.target

[Service]
Type=simple
User=nodiscord
Group=nodiscord
WorkingDirectory=/opt/nodiscord/.deploy/backend
Environment=ASPNETCORE_URLS=http://127.0.0.1:%i
EnvironmentFile=-/opt/nodiscord/.deploy/backend/.env
EnvironmentFile=-/etc/nodiscord/backend-%i.env
ExecStart=/usr/bin/dotnet /opt/nodiscord/.deploy/backend/BackNoDiscord.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=nodiscord-backend-%i

[Install]
WantedBy=multi-user.target
